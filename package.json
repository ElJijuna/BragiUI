{
  "name": "@pilmee/bragiui",
  "version": "1.0.0",
  "description": "A React component library built with Vite",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./welcome": {
      "types": "./dist/components/Welcome/Welcome.d.ts",
      "default": "./dist/Welcome.js"
    },
    "./color-scheme-toggle": {
      "types": "./dist/components/ColorSchemeToggle/ColorSchemeToggle.d.ts",
      "default": "./dist/ColorSchemeToggle.js"
    },
    "./cve-summary": {
      "types": "./dist/components/CVESummary/CVESummary.d.ts",
      "default": "./dist/CVESummary.js"
    },
    "./navbar": {
      "types": "./dist/components/Navbar/Navbar.d.ts",
      "default": "./dist/Navbar.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "keywords": [
    "react",
    "components",
    "library",
    "ui"
  ],
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}