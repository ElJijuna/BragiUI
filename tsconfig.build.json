{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": false,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src/index.ts", "src/components/**/*.tsx", "src/components/**/*.ts"],
    "exclude": [
        "**/*.test.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/*Example.tsx",
        "src/setupTests.ts"
    ]
}
